# Copy to .env and fill in real values. Never commit .env.
# Bank-officer account created automatically on API start-up (if it does not exist yet).
FRAUDGUARD_OFFICER_EMAIL=officer@example.com
FRAUDGUARD_OFFICER_PASSWORD=change-me-to-a-strong-password
FRAUDGUARD_OFFICER_NAME=Loan Officer

# ADMIN / technical account (separate from the bank officer; opens the technical panel).
FRAUDGUARD_ADMIN_EMAIL=admin@example.com
FRAUDGUARD_ADMIN_PASSWORD=change-me-to-another-strong-password
FRAUDGUARD_ADMIN_NAME=Technical Admin

# Optional
# FRAUDGUARD_DB_PATH=storage/fraudguard.db
# FRAUDGUARD_SESSION_HOURS=12
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# VITE_API_URL=http://localhost:8000
